NOWIS_ADMIN_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
ADMIN_EMAIL=admin@example.com
# Unique password: at least 16 characters, at most 72 UTF-8 bytes.
ADMIN_PASSWORD=
ADMIN_NAME=NoWis Admin
# Generate a unique random secret of at least 32 bytes; no fallback is accepted.
ADMIN_JWT_SECRET=
BLOB_READ_WRITE_TOKEN=

# Destructive CLI seed is only for a disposable local database; always blocked in production.
ALLOW_DESTRUCTIVE_DEMO_SEED=false

# Note: this project uses a custom cookie/JWT auth flow.
# NEXTAUTH_URL is not used by NoWisAdmin.
